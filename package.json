{
  "name": "browser-assistant",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:extension": "pnpm --filter @browser-assistant/extension dev",
    "dev:backend": "pnpm --filter @browser-assistant/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "5.1.1",
      "shell-quote": "1.11.0",
      "tmp": "0.2.7",
      "adm-zip": "0.6.1",
      "tinypool": "2.1.2"
    }
  }
}
